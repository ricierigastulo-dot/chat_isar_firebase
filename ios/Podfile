# Fijamos la plataforma mínima a iOS 13.0
platform :ios, '13.0'

# Carga de utilidades internas de Flutter
podfile_properties = {}
if File.exist?('podfile_properties.rb')
  def parse_podfile_properties
    properties = {}
    File.readlines('podfile_properties.rb').each do |line|
      key, value = line.split('=')
      properties[key.strip] = value.strip if key && value
    end
    properties
  end
  podfile_properties = parse_podfile_properties
end

# Inclusión del script auxiliar del SDK de Flutter
flutter_ios_podfile_setup = File.join(File.dirname(File.realpath(__FILE__)), '.symlinks', 'plugins')
load File.join(File.dirname(File.realpath(__FILE__)), 'Flutter', 'podhelper.rb')

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    
    # Forzar target a iOS 13.0 en cada plugin (resuelve el error -G)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
    end
  end
end